# 이 파일을 .env 로 복사한 뒤 실제 값으로 변경하여 사용하세요. (.env 는 git에 커밋하지 않습니다)

# MongoDB root 계정 비밀번호 (필수) - 미설정 시 컨테이너 기동이 실패합니다.
MONGO_INITDB_ROOT_PASSWORD=change-me-root-password
MONGO_INITDB_ROOT_USERNAME=root

# 애플리케이션(com 데이터베이스) 접속 계정 - 실사용시 반드시 변경하세요.
# db.createUser() 로 별도 생성해야 하며(readme.txt 참고), 여기서는 app(ex-egovframe-stream-*)의
# application.yml 접속 정보와 값을 맞추기 위해서만 사용됩니다.
MONGO_USERNAME=com
MONGO_PASSWORD=change-me-app-password
