# 이 파일을 .env 로 복사한 뒤 실제 값으로 변경하여 사용하세요. (.env 는 git에 커밋하지 않습니다)

# MongoDB root 계정 - 비밀번호는 필수이며 미설정 시 컨테이너 기동이 실패합니다.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root-password

# 애플리케이션 계정 (최초 기동 시 init-user.js 가 MONGODB_DATABASE 에 dbOwner 로 생성)
# 실사용 시 반드시 변경하고, sub 모듈의 MONGODB_URI 에 같은 값을 지정합니다.
MONGODB_DATABASE=com
MONGO_USERNAME=com
MONGO_PASSWORD=change-me-app-password
